# ==============================================================================
# VARIABLES PUBLIQUES (FRONTEND / CLIENT VITE)
# Ces variables sont injectées dans le bundle navigateur (préfixe VITE_ obligatoire)
# ==============================================================================

# URL publique de votre instance Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé API anonyme publique Supabase (avec politiques RLS strictes)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL de production du site (utilisée pour les redirections et liens d'emails)
VITE_APP_URL=https://votre-domaine.vercel.app


# ==============================================================================
# VARIABLES SECRÈTES (SERVEUR / VERCEL CRON / EDGE FUNCTIONS)
# ⚠️ STRICTEMENT PRIVÉES : Ne JAMAIS préfixer par VITE_ ou NEXT_PUBLIC_
# Accessibles uniquement côté serveur via process.env ou Deno.env
# ==============================================================================

# Clé secrète de service Supabase (Droits complets sans RLS, serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé API Resend pour l'envoi des emails transactionnels (confirmations & rappels)
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=Cindy Malorie <notifications@cindymalorie.com>

# Secret partagé pour protéger les exécutions de Cron Jobs (Vercel & Supabase)
CRON_SECRET=generer_un_secret_aleatoire_tres_robuste_ex_64_caracteres

# Identifiants Twilio (Optionnel, pour les rappels par SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
